{
    "$schema": "https://railway.app/datamodel.schema.json",
    "build": {
        "builder": "NIXPACKS",
        "watchPatterns": [
            "backend/**"
        ]
    },
    "deploy": {
        "startCommand": "php backend/artisan serve --host=0.0.0.0 --port=${PORT}",
        "restartPolicyType": "ON_FAILURE",
        "rootDirectory": "backend"
    }
}